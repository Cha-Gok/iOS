# SwiftFormat Configuration - ChaGok
# https://github.com/nicklockwood/SwiftFormat

--exclude Derived,Tuist,.build,build,*/.build,**/Resources,**/Assets.xcassets,**/Preview Content

--indent 4
--maxwidth 120
--trimwhitespace always
--linebreaks lf
--commas always
--semicolons inline
--header strip
--swiftversion 6.0

--allman false
--elseposition same-line
--wraparguments preserve
--wrapcollections preserve
--wrapconditions after-first

--self remove
--importgrouping testable-bottom
